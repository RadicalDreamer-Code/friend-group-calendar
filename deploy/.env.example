# Production settings. Copy to .env next to compose.yaml and fill in every value.
# Never commit the real .env.

# The web app is served at https://app.DOMAIN and the API at https://api.DOMAIN.
# Point both DNS names (A/AAAA records) at this server before the first start.
DOMAIN=example.com
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=you@example.com

# Database. Generate the password with: openssl rand -hex 24
POSTGRES_USER=calendar
POSTGRES_PASSWORD=
POSTGRES_DB=calendar

# Keys the sign-in code hashes. Generate with: openssl rand -hex 32
# Changing it later only invalidates codes that are in flight, not sessions.
AUTH_SECRET=

# Email for sign-in codes, over SMTP. Resend: host smtp.resend.com,
# username "resend", password = an API key. Postmark: host smtp.postmarkapp.com,
# username and password = a server token. The sender's domain must be verified there.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
MAIL_FROM=Friend Calendar <hello@example.com>

# Avatars, in an S3-compatible bucket. Cloudflare R2: endpoint
# <account-id>.r2.cloudflarestorage.com, region auto, an API token with
# Object Read & Write on the bucket. AWS S3: s3.<region>.amazonaws.com.
# The bucket stays private; the API serves the images.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=avatars
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Daily database dump into ./backups (hour in UTC, days to keep).
BACKUP_HOUR_UTC=3
BACKUP_KEEP_DAYS=14

# The containers' network, and Caddy's addresses in it. Change a subnet and its
# Caddy address together, and only if the subnet clashes with a network on the server.
# NETWORK_SUBNET=172.28.80.0/24
# CADDY_IP=172.28.80.10
# NETWORK_SUBNET6=fd7c:28:80::/64
# CADDY_IP6=fd7c:28:80::10
