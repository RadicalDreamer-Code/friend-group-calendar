# Copy to .env to override the defaults in compose.yaml.

# Host ports
WEB_PORT=8082
API_PORT=8080
DB_PORT=5433
MAILPIT_UI_PORT=8025
S3_CONSOLE_PORT=9001
# Interface the API and web app listen on. 0.0.0.0 makes them reachable from
# other devices on your network (needed for testing on a phone).
# Postgres, Mailpit and object storage always stay on 127.0.0.1.
HOST_BIND=127.0.0.1
# When testing on a phone, also point these at your computer's LAN address:
# API_PUBLIC_URL=http://192.168.1.20:8080
# API_ALLOWED_ORIGINS=http://localhost:8082,http://192.168.1.20:8082
# The web app over plain http on a LAN address needs non-Secure cookies
# (localhost is fine either way). Never set this to false in production.
# COOKIE_SECURE=false

# Local database credentials (development only)
POSTGRES_USER=calendar
POSTGRES_PASSWORD=calendar
POSTGRES_DB=calendar

# Local object storage credentials (development only)
S3_ACCESS_KEY=calendar
S3_SECRET_KEY=calendar-dev-secret

# Signs sign-in codes. The default in compose.yaml is for development only.
# AUTH_SECRET=
